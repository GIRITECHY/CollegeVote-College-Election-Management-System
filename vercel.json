{
  "rewrites": [
    { "source": "/api/elections/:id/open", "destination": "/api/elections/[id]" },
    { "source": "/api/elections/:id/close", "destination": "/api/elections/[id]" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
